# CanCan controller additions — the load_and_authorize_resource engine.
#
# Two layers, mirroring the gem's controller_additions.rb +
# controller_resource*.rb:
#
# 1. `CanCan::ControllerResource` — the load/authorize logic over a
#    controller seam (`CanCan::ControllerAdditions`): params access,
#    instance store, current_ability, action symbol, skips. Oracle-
#    exercised with a fake controller (oracle/cases.rb third pass).
# 2. ActionController::Base integration (action_pack_cr): the
#    `load_and_authorize_resource` / `load_resource` /
#    `authorize_resource` macros register before-actions and generate
#    typed resource getters; a `macro finished` hook generates the
#    runtime action-string → Symbol dispatch (Crystal has no
#    String#to_sym).
#
# Model-class resolution replaces the gem's runtime `constantize` with a
# compile-time registry: `CanCan.register_model Article` (macro). The
# generated `CanCan.model_for` case returns a union of CONCRETE
# metaclasses — the static `ActiveRecord::Base.class` type does not know
# per-model methods generated by active_record_cr's codegen (same
# constraint devise_cr solves with typed procs).

require "action_pack_cr"

module CanCan
  # Params values the resource loader works with (nested hashes allowed).
  alias ParamValue = String | Int64 | Bool | Nil | Hash(String, ParamValue)
  alias ParamHash = Hash(String, ParamValue)

  # Compile-time model registry: {underscored resource name, class}.
  REGISTERED_MODELS = [] of Nil

  macro register_model(klass)
    {% found = false %}
    {% for m in CanCan::REGISTERED_MODELS %}
      {% if m[1].stringify == klass.stringify %}{% found = true %}{% end %}
    {% end %}
    {% unless found %}
      {% CanCan::REGISTERED_MODELS << {klass.id.stringify.underscore, klass} %}
    {% end %}
  end

  def self.to_param_value(v) : ParamValue
    case v
    when Hash
      h = {} of String => ParamValue
      v.each { |k, vv| h[k.to_s] = to_param_value(vv) }
      h
    when Int32                    then v.to_i64
    when String, Int64, Bool, Nil then v
    else
      v.to_s
    end
  end

  # ActionController::Parameters::Value → ParamValue.
  def self.from_parameters_value(v) : ParamValue?
    case v
    when ActionController::Parameters
      h = {} of String => ParamValue
      v.to_h.each { |k, vv| h[k] = from_parameters_value(vv).not_nil! }
      h
    when String, Int64, Bool, Nil then v
    when Int32                    then v.to_i64
    else
      nil
    end
  end

  # skip_load/skip_authorize options (gem's cancan_skipper entry).
  struct SkipOptions
    property only : Array(Symbol)?
    property except : Array(Symbol)?

    def initialize(@only : Array(Symbol)?, @except : Array(Symbol)?)
    end
  end

  # The controller seam. Fake controllers (oracle spec) include it
  # directly; ActionController::Base includes it with `params` bridged.
  module ControllerAdditions
    @cancan_params = {} of String => ParamValue
    @cancan_instances = {} of String => ActiveRecord::Base
    @cancan_collections = {} of String => Array(ActiveRecord::Base)
    @cancan_authorized = false
    @cancan_skipper = {"load"      => {} of String => SkipOptions,
                       "authorize" => {} of String => SkipOptions}

    # --- params seam ---------------------------------------------------

    # Fake/test controllers: plain hash params. ActionController::Base
    # bridges to its own `params` instead (cancan_param override).
    def cancan_set_params(params : Hash) : Nil
      converted = {} of String => ParamValue
      params.each { |k, v| converted[k.to_s] = CanCan.to_param_value(v) }
      @cancan_params = converted
    end

    def cancan_param(key : String) : ParamValue?
      @cancan_params[key]?
    end

    # The current action as a Symbol. Crystal has no runtime String#to_sym;
    # ActionController subclasses get a generated dispatch (macro finished
    # below); other controllers define this themselves.
    def cancan_action : Symbol?
      nil
    end

    # --- ability seam --------------------------------------------------

    def current_ability : CanCan::Ability
      raise NotImplementedError.new("#{self.class} must define current_ability")
    end

    def authorize!(action : Symbol, subject : Subject, message : String? = nil) : Subject
      @cancan_authorized = true
      current_ability.authorize!(action, subject, message)
    end

    # Nested subject authorize (the gem's {parent => child} subject).
    def authorize!(action : Symbol, *, parent : ActiveRecord::Base, child : Subject,
                   message : String? = nil) : Nil
      @cancan_authorized = true
      unless current_ability.can?(action, parent: parent, child: child)
        raise AccessDenied.new(message || "You are not authorized to access this page.", action, child)
      end
    end

    def can?(action : Symbol, subject : Subject) : Bool
      current_ability.can?(action, subject)
    end

    def cannot?(action : Symbol, subject : Subject) : Bool
      current_ability.cannot?(action, subject)
    end

    def cancan_authorized? : Bool
      @cancan_authorized
    end

    # --- instance store ------------------------------------------------
    # The gem writes @<name> ivars via instance_variable_set; Crystal has
    # no runtime ivar access, so the seam stores resources here (the
    # ActionController macro layer generates typed getters over it).

    def cancan_instance(name : String) : ActiveRecord::Base?
      @cancan_instances[name]?
    end

    def cancan_set_instance(name : String, value : ActiveRecord::Base?) : Nil
      if v = value
        @cancan_instances[name] = v
      else
        @cancan_instances.delete(name)
      end
    end

    def cancan_instance_defined?(name : String) : Bool
      @cancan_instances.has_key?(name)
    end

    def cancan_collection(name : String) : Array(ActiveRecord::Base)?
      @cancan_collections[name]?
    end

    def cancan_set_collection(name : String, value : Array(ActiveRecord::Base)) : Nil
      @cancan_collections[name] = value
    end

    def cancan_collection_defined?(name : String) : Bool
      @cancan_collections.has_key?(name)
    end

    # A `through:` parent (gem: ivar or controller method). Controllers
    # override to expose parent-fetching methods; the default reads the
    # instance store.
    def cancan_fetch_parent(name : String) : ActiveRecord::Base?
      cancan_instance(name)
    end

    # --- skips ---------------------------------------------------------

    def cancan_skip(behavior : String, name : Symbol? = nil,
                    only : Array(Symbol)? = nil, except : Array(Symbol)? = nil) : Nil
      @cancan_skipper[behavior][name.to_s] = SkipOptions.new(only, except)
    end

    def cancan_skip_options(behavior : String, name : Symbol?) : SkipOptions?
      @cancan_skipper[behavior][name.to_s]?
    end

    # Strong parameters seam: sanitizing controllers override (the gem
    # resolves <action>_params / <name>_params with respond_to?). Return
    # nil to fall back to the raw resource params.
    def cancan_permitted_params(name : String, action : String) : ParamHash?
      nil
    end
  end

  # --- ControllerResource (gem controller_resource*.rb) ---------------------

  class ControllerResource
    def initialize(@controller : ControllerAdditions, @name : Symbol? = nil, *,
                   @parent_flag : Bool? = nil,
                   @through : Symbol? = nil,
                   @through_association : Symbol? = nil,
                   @singleton : Bool = false,
                   @shallow : Bool = false,
                   @model : ActiveRecord::Base.class | Symbol? = nil,
                   @instance_name_opt : Symbol? = nil,
                   @find_by : Symbol? = nil,
                   @id_param_opt : Symbol? = nil,
                   @collection_actions_opt : Array(Symbol)? = nil,
                   @new_actions_opt : Array(Symbol)? = nil,
                   @parent_action : Symbol? = nil)
    end

    def load_and_authorize_resource : Nil
      load_resource
      authorize_resource
    end

    def load_resource : Nil
      return if skip?("load")
      if load_instance?
        unless @controller.cancan_instance_defined?(instance_name)
          if (instance = load_resource_instance)
            @controller.cancan_set_instance(instance_name, instance)
          end
        end
      elsif load_collection?
        unless @controller.cancan_collection_defined?(collection_name)
          @controller.cancan_set_collection(collection_name, load_collection)
        end
      end
    end

    def authorize_resource : Nil
      return if skip?("authorize")
      if (instance = resource_instance)
        @controller.authorize!(authorization_action, instance)
      elsif (parent = parent_resource)
        @controller.authorize!(authorization_action, parent: parent, child: resource_class)
      else
        @controller.authorize!(authorization_action, resource_class)
      end
    end

    def parent? : Bool
      return @parent_flag.not_nil! unless @parent_flag.nil?
      !@name.nil? && @name.to_s != name_from_controller
    end

    # --- resolution helpers ------------------------------------------------

    private def action_string : String
      action = @controller.cancan_action
      action ? action.to_s : ""
    end

    private def controller_name : String
      value = @controller.cancan_param("controller")
      value.is_a?(String) ? value : ""
    end

    # "articles" / "admin/articles" → "article" (last path segment,
    # singularized).
    private def name_from_controller : String?
      last = controller_name.split("/")[-1]?
      return nil if last.nil? || last.empty?
      singular = ActiveRecord::Migrations.singularize(last)
      singular.empty? ? nil : singular
    end

    private def resource_name : String
      @name ? @name.to_s : name_from_controller.not_nil!
    end

    private def instance_name : String
      (@instance_name_opt || resource_name).to_s
    end

    private def collection_name : String
      ActiveRecord::Migrations.pluralize(instance_name)
    end

    # The key the model is registered under: the explicit `model:`
    # option's own name when given, else the resource name.
    private def model_key : String
      if (m = @model).is_a?(ActiveRecord::Base.class)
        CanCan.name_for(m) || resource_name
      else
        resource_name
      end
    end

    # The class used for loading and authorizing. `class: false` in the
    # gem becomes a Symbol subject (authorization only, nothing to load).
    def resource_class : Subject
      if (m = @model).is_a?(Symbol)
        m
      else
        CanCan.model_class(model_key)
      end
    end

    # params key holding this resource's attributes (instance_name /
    # class name / namespaced name in the gem).
    private def params_key : String
      if (m = @model).is_a?(ActiveRecord::Base.class)
        ActiveRecord::Migrations.singularize(CanCan.model_table_name(model_key))
      else
        resource_name
      end
    end

    # --- loading ------------------------------------------------------------

    private def load_instance? : Bool
      parent? || member_action?
    end

    private def load_collection? : Bool
      !@controller.current_ability.has_block?(authorization_action, resource_class)
    end

    private def member_action? : Bool
      id = id_value
      new_action_list.includes?(action_string) || @singleton ||
        (!id.nil? && !collection_action_list.includes?(action_string))
    end

    private def new_action_list : Array(String)
      ([:new, :create] + (@new_actions_opt || [] of Symbol)).map(&.to_s)
    end

    private def collection_action_list : Array(String)
      ([:index] + (@collection_actions_opt || [] of Symbol)).map(&.to_s)
    end

    private def id_param_key : String
      if key = @id_param_opt
        key.to_s
      else
        parent? ? "#{resource_name}_id" : "id"
      end
    end

    private def id_value : String?
      value = @controller.cancan_param(id_param_key)
      value.nil? || value == "" ? nil : value.to_s
    end

    # The gem's resource_base_through: loading through a missing parent
    # (no `through:` ivar found) is an authorization failure unless
    # `shallow:` allows falling back to the class.
    private def require_through_parent : Nil
      return unless @through
      return if @shallow || parent_resource
      raise AccessDenied.new(
        "You are not authorized to access this page.", authorization_action, resource_class)
    end

    private def parent_name : String?
      return nil unless through = @through
      @controller.cancan_fetch_parent(through.to_s) ? through.to_s : nil
    end

    private def parent_resource : ActiveRecord::Base?
      (name = parent_name) ? @controller.cancan_fetch_parent(name) : nil
    end

    # The association children to load through (exposed via
    # cancan_attribute), or nil when loading straight off the class.
    private def through_children : Array(ActiveRecord::Base)?
      return nil unless parent = parent_resource
      assoc = (@through_association || resource_name).to_s
      parent.cancan_attribute(ActiveRecord::Migrations.pluralize(assoc))
        .as?(Array(ActiveRecord::Base))
    end

    private def load_collection : Array(ActiveRecord::Base)
      require_through_parent
      if parent_resource
        raise Error.new("Collection loading through a parent association is not supported")
      end
      CanCan.model_accessible_records(model_key, @controller.current_ability, authorization_action)
    end

    private def load_resource_instance : ActiveRecord::Base?
      if !parent? && new_action_list.includes?(action_string)
        build_resource
      elsif id_value || @singleton
        find_resource
      end
    end

    private def find_resource : ActiveRecord::Base?
      require_through_parent
      if @singleton && (parent = parent_resource) &&
         (assoc = parent.cancan_attribute(resource_name)).is_a?(ActiveRecord::Base)
        assoc
      elsif find_by = @find_by
        col = %("#{find_by.to_s.gsub('"', "")}")
        value = id_value.to_s
        CanCan.model_where_first(model_key, col, value) ||
          raise ActiveRecord::RecordNotFound.new(
            "Couldn't find #{model_key} with #{find_by}=#{value}")
      elsif (id = id_value)
        if (children = through_children)
          children.find { |child| child.id == id.to_i64? } ||
            raise ActiveRecord::RecordNotFound.new(
              "Couldn't find #{model_key} id=#{id} through #{parent_name}")
        else
          CanCan.model_find(model_key, id.to_i64)
        end
      end
    end

    # --- building -----------------------------------------------------------

    private def build_resource : ActiveRecord::Base
      require_through_parent
      params_hash = resource_params || {} of String => ParamValue
      parent = parent_resource
      record = CanCan.model_new(model_key)
      CanCan.model_assign(model_key, record, ControllerResource.param_attrs(params_hash))
      if parent
        if (fk = parent_foreign_key(parent)) && (pid = parent.id)
          CanCan.model_assign(model_key, record, {fk => pid.as(ActiveRecord::Value)})
        end
      end
      initial = {} of String => ActiveRecord::Value
      @controller.current_ability.attributes_for(action_symbol, resource_class).each do |k, v|
        next if params_hash.has_key?(k)
        initial[k] = v.as(ActiveRecord::Value) unless v.is_a?(Hash) || v.is_a?(Array) ||
                                                      v.is_a?(Range) || v.is_a?(RawScope)
      end
      CanCan.model_assign(model_key, record, initial) unless initial.empty?
      record
    end

    # The foreign key on the child model pointing at the parent
    # (belongs_to reflection by table name, `_id` convention fallback).
    private def parent_foreign_key(parent : ActiveRecord::Base) : String?
      parent_table = CanCan.class_table_name(parent.class)
      spec = CanCan.model_assoc_specs(model_key).find do |s|
        s[:kind] == "belongs_to" && s[:table] == parent_table
      end
      spec ? spec[:foreign_key] : "#{ActiveRecord::Migrations.singularize(parent_table)}_id"
    end

    private def parameters_require_sanitizing? : Bool
      {"create", "update"}.includes?(action_string) || !raw_resource_params.nil?
    end

    private def raw_resource_params : ParamHash?
      @controller.cancan_param(params_key).as?(Hash(String, ParamValue))
    end

    private def resource_params : ParamHash?
      if parameters_require_sanitizing?
        @controller.cancan_permitted_params(resource_name, action_string) || raw_resource_params
      else
        raw_resource_params
      end
    end

    # --- authorization --------------------------------------------------------

    private def authorization_action : Symbol
      parent? ? (@parent_action || :show) : action_symbol
    end

    private def action_symbol : Symbol
      action = @controller.cancan_action
      raise Error.new("Unknown action '#{action_string}' for #{self.class}") unless action
      action
    end

    private def resource_instance : ActiveRecord::Base?
      return nil unless load_instance?
      @controller.cancan_instance(instance_name)
    end

    private def skip?(behavior : String) : Bool
      options = @controller.cancan_skip_options(behavior, @name)
      return false unless options
      return true if options.only.nil? && options.except.nil?
      if (ex = options.except) && !ex.map(&.to_s).includes?(action_string)
        true
      elsif (on = options.only) && on.map(&.to_s).includes?(action_string)
        true
      else
        false
      end
    end

    # ParamValue hash → ActiveRecord attribute hash.
    def self.param_attrs(params : ParamHash) : Hash(String, ActiveRecord::Value)
      attrs = {} of String => ActiveRecord::Value
      params.each do |k, v|
        attrs[k] = v.as(ActiveRecord::Value) unless v.is_a?(Hash)
      end
      attrs
    end
  end
end

# --- ActionController::Base integration ----------------------------------

class ActionController::Base
  include CanCan::ControllerAdditions

  # Bridge the seam to ActionController::Parameters.
  def cancan_param(key : String) : CanCan::ParamValue?
    CanCan.from_parameters_value(params[key]?)
  end

  macro load_and_authorize_resource(name = nil, **opts)
    cancan_resource_filter(:load_and_authorize_resource, {{ name }}, {{ opts }})
  end

  macro load_resource(name = nil, **opts)
    cancan_resource_filter(:load_resource, {{ name }}, {{ opts }})
  end

  macro authorize_resource(name = nil, **opts)
    cancan_resource_filter(:authorize_resource, {{ name }}, {{ opts }})
  end

  # Shared expansion: before-action filter + typed resource getters.
  # Resource class resolution is compile-time (no runtime constantize):
  # `model:`/`class:` option, else conventional naming from the
  # controller/resource name (ArticlesController → article → Article).
  macro cancan_resource_filter(method, name, opts)
    {% raw_name = (name ? name.stringify : @type.name.split("::").last.gsub(/Controller$/, "").underscore) %}
    {% base_name = raw_name.gsub(/^:/, "") %}
    {% singular = base_name.ends_with?("s") ? base_name.rchop : base_name %}
    {% plural = singular + "s" %}
    {% klass = opts["model"] || opts["class"] %}
    {% if klass %}{% klass = klass.id %}{% else %}{% klass = singular.split("_").map(&.capitalize).join.id %}{% end %}
    CanCan.register_model({{ klass }})
    {% method_name = "__cancan_resource_#{ActionController::FILTERS.size}".id %}
    def {{ method_name }} : Nil
      CanCan::ControllerResource.new(self,
        {% if name %}{{ name }},{% end %}
        model: {{ klass }},
        {% for k, v in opts %}
          {% key = k.stringify %}
          {% unless ["only", "except", "if", "unless", "model", "class", "new"].includes?(key) %}
            {{ k.id }}: ({{ v }}),
          {% end %}
        {% end %}
        {% if opts["new"] %}new_actions: ({{ opts["new"] }}),{% end %}
      ).{{ method.id }}
    end
    {% ActionController::FILTERS << {@type, method_name.symbolize, {only: opts[:only], except: opts[:except]}} %}

    def {{ singular.id }} : {{ klass }}?
      cancan_instance({{ singular }}).as?({{ klass }})
    end

    def {{ plural.id }} : Array({{ klass }})?
      cancan_collection({{ plural }}).try { |list| list.map(&.as({{ klass }})) }
    end
  end
end

# End-of-program codegen:
# - CanCan.model_* dispatchers: per-operation dispatch over the registered
#   models. Each case branch calls on the LITERAL class — the static
#   `ActiveRecord::Base.class` type does not know per-model methods
#   generated by active_record_cr's codegen (same constraint devise_cr
#   solves with typed procs), and unions/params collapse the metaclass.
# - cancan_action: action-string → Symbol dispatch for every registered
#   controller (Crystal has no String#to_sym; actions are compile-time
#   known). Runs alongside action_pack's own finished hook.
macro finished
  module CanCan
    def self.model_class(name : String) : Subject
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then {{ m[1] }}
      {% end %}
      else
        raise Error.new(
          "Cannot resolve model class for resource '#{name}'. " \
          "Register it with CanCan.register_model.")
      end
    end

    def self.model_table_name(name : String) : String
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then {{ m[1] }}.table_name
      {% end %}
      else
        raise Error.new("Unknown model '#{name}'")
      end
    end

    def self.model_find(name : String, id : Int64) : ActiveRecord::Base
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then {{ m[1] }}.find(id)
      {% end %}
      else
        raise Error.new("Unknown model '#{name}'")
      end
    end

    def self.model_where_first(name : String, condition : String, value : String) : ActiveRecord::Base?
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then {{ m[1] }}.where(%(#{condition} = ?), value).first?
      {% end %}
      else
        raise Error.new("Unknown model '#{name}'")
      end
    end

    def self.model_new(name : String) : ActiveRecord::Base
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then {{ m[1] }}.new
      {% end %}
      else
        raise Error.new("Unknown model '#{name}'")
      end
    end

    def self.model_assign(name : String, record : ActiveRecord::Base,
                          attrs : Hash(String, ActiveRecord::Value)) : Nil
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then record.as({{ m[1] }}).assign_attributes(attrs)
      {% end %}
      else
        raise Error.new("Unknown model '#{name}'")
      end
    end

    def self.model_assoc_specs(name : String) : Array(ActiveRecord::AssocSpec)
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then {{ m[1] }}.__assoc_specs
      {% end %}
      else
        raise Error.new("Unknown model '#{name}'")
      end
    end

    def self.model_accessible_records(name : String, ability, action : Symbol) : Array(ActiveRecord::Base)
      case name
      {% for m in CanCan::REGISTERED_MODELS %}
      when {{ m[0] }} then {{ m[1] }}.accessible_by(ability, action).to_a.map(&.as(ActiveRecord::Base))
      {% end %}
      else
        raise Error.new("Unknown model '#{name}'")
      end
    end

    def self.name_for(klass : ActiveRecord::Base.class) : String?
{% if CanCan::REGISTERED_MODELS.size > 0 %}
      if klass == {{ CanCan::REGISTERED_MODELS[0][1] }}
        {{ CanCan::REGISTERED_MODELS[0][0] }}
      {% for m in CanCan::REGISTERED_MODELS[1..] %}
      elsif klass == {{ m[1] }}
        {{ m[0] }}
      {% end %}
      else
        nil
      end
    {% else %}
      nil
    {% end %}
    end

    def self.class_table_name(klass : ActiveRecord::Base.class) : String
{% if CanCan::REGISTERED_MODELS.size > 0 %}
      if klass == {{ CanCan::REGISTERED_MODELS[0][1] }}
        {{ CanCan::REGISTERED_MODELS[0][1] }}.table_name
      {% for m in CanCan::REGISTERED_MODELS[1..] %}
      elsif klass == {{ m[1] }}
        {{ m[1] }}.table_name
      {% end %}
      else
        raise Error.new("Unregistered model class " + klass.to_s)
      end
    {% else %}
      raise Error.new("Unregistered model class " + klass.to_s)
    {% end %}
    end

    # nil-returning variants for the core Rule matcher (nested subjects
    # work without registration via the class-name fallback). NOTE:
    # if/elsif with `==` — `case x; when SomeClass` is an is_a? check
    # on instances and never matches class objects.
    def self.class_table_name?(klass : ActiveRecord::Base.class) : String?
{% if CanCan::REGISTERED_MODELS.size > 0 %}
      if klass == {{ CanCan::REGISTERED_MODELS[0][1] }}
        {{ CanCan::REGISTERED_MODELS[0][1] }}.table_name
      {% for m in CanCan::REGISTERED_MODELS[1..] %}
      elsif klass == {{ m[1] }}
        {{ m[1] }}.table_name
      {% end %}
      else
        nil
      end
    {% else %}
      nil
    {% end %}
    end

    def self.class_assoc_specs?(klass : ActiveRecord::Base.class) : Array(ActiveRecord::AssocSpec)?
{% if CanCan::REGISTERED_MODELS.size > 0 %}
      if klass == {{ CanCan::REGISTERED_MODELS[0][1] }}
        {{ CanCan::REGISTERED_MODELS[0][1] }}.__assoc_specs
      {% for m in CanCan::REGISTERED_MODELS[1..] %}
      elsif klass == {{ m[1] }}
        {{ m[1] }}.__assoc_specs
      {% end %}
      else
        nil
      end
    {% else %}
      nil
    {% end %}
    end
  end

  {% for t in ActionController::REGISTRY %}
    {% unless t.abstract? %}
      {% has_own = t.methods.any? { |m| m.name.stringify == "cancan_action" } %}
      {% unless has_own %}
        {% callback_names = [] of String %}
        {% for f in ActionController::FILTERS %}
          {% if f[0] == t || t.ancestors.includes?(f[0]) %}
            {% callback_names << f[1].stringify.gsub(/^:/, "") %}
          {% end %}
        {% end %}
        {% for f in ActionController::AROUND_FILTERS %}
          {% if f[0] == t || t.ancestors.includes?(f[0]) %}
            {% callback_names << f[1].stringify.gsub(/^:/, "") %}
          {% end %}
        {% end %}
        {% for r in ActionController::RESCUERS %}
          {% if r[0] == t || t.ancestors.includes?(r[0]) %}
            {% callback_names << r[2].stringify.gsub(/^:/, "") %}
          {% end %}
        {% end %}
        class ::{{ t.stringify.id }}
          def cancan_action : Symbol?
            case params["action"].to_s
            {% for m in t.methods %}
              {% is_action = m.args.empty? && !m.name.stringify.starts_with?("__") && m.name.stringify != m.name.stringify.capitalize && !callback_names.includes?(m.name.stringify) %}
              {% if is_action %}
            when {{ m.name.stringify }} then :{{ m.name.id }}
              {% end %}
            {% end %}
            else
              nil
            end
          end
        end
      {% end %}
    {% end %}
  {% end %}
end
